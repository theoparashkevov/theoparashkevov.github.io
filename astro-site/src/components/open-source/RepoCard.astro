---
import Icon from '../Icon.astro';
import type { GitHubRepo } from '../../lib/github';

export interface Props {
  repo: GitHubRepo;
}

const { repo } = Astro.props;

const LANGUAGE_COLORS: Record<string, string> = {
  Python: '#3572a5',
  TypeScript: '#3178c6',
  JavaScript: '#f1e05a',
  'Jupyter Notebook': '#da5b0b',
  HTML: '#e34c26',
  CSS: '#563d7c',
  Shell: '#89e051',
  'C++': '#f34b7d',
  C: '#9a9e9b',
  Rust: '#dea584',
  Go: '#00add8',
  Java: '#b07219',
  'C#': '#178600',
  PHP: '#4f5d95',
  Ruby: '#701516',
  Swift: '#f05138',
  Kotlin: '#a97bff',
  Lua: '#5b63b3',
  R: '#198ce7',
  Scala: '#c22d40',
  Zig: '#ec915c',
  Dart: '#00b4ab',
  Julia: '#a270ba',
  Haskell: '#5e5086',
  Nix: '#7e7eff',
  Dockerfile: '#5b63b8',
};

const languageColor = repo.language ? (LANGUAGE_COLORS[repo.language] ?? 'var(--accent)') : null;

// Sparkline: 12 monthly values as an SVG bar chart.
const W = 96;
const H = 28;
const maxMonthly = Math.max(1, ...repo.monthly);
const barWidth = W / 12;
const bars = repo.monthly.map((count, i) => {
  const height = count === 0 ? 1 : Math.max(2, (count / maxMonthly) * (H - 4));
  return { x: i * barWidth, height };
});

const pushedLabel = new Date(repo.pushedAt).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<article class="group relative flex flex-col gap-4 rounded-2xl border border-border bg-surface p-6 shadow-soft transition-colors duration-300 hover:border-accent/40 sm:p-7">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <h3 class="text-lg font-semibold tracking-tight text-fg">
        <a
          href={repo.url}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-sm transition-colors group-hover:text-accent after:absolute after:inset-0 after:rounded-2xl after:content-[''] focus-visible:outline-none focus-visible:after:ring-2 focus-visible:after:ring-accent"
        >
          {repo.name}
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </h3>
      {repo.language && (
        <p class="mt-1 flex items-center gap-1.5 text-xs font-medium text-muted">
          <span class="size-2.5 rounded-full" style={`background-color: ${languageColor};`} />
          {repo.language}
        </p>
      )}
    </div>
    <Icon
      name="external"
      size={18}
      class="mt-1 shrink-0 text-subtle transition-[color,translate] duration-300 ease-out-expo group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent motion-reduce:transition-none motion-reduce:group-hover:translate-none"
    />
  </div>

  <p class="flex-1 text-sm leading-relaxed text-muted">
    {repo.description ?? 'No description provided.'}
  </p>

  <div class="flex items-end justify-between gap-4">
    <div class="flex items-center gap-4 text-xs text-subtle">
      <span class="inline-flex items-center gap-1" title="Stars">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path>
        </svg>
        {repo.stars}
      </span>
      <span class="inline-flex items-center gap-1" title="Forks">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.25 2.25 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"></path>
        </svg>
        {repo.forks}
      </span>
      <span class="hidden sm:inline">updated {pushedLabel}</span>
    </div>

    {repo.sparkline && (
      <svg
        width={W}
        height={H}
        viewBox={`0 0 ${W} ${H}`}
        class="shrink-0 text-accent/70"
        role="img"
        aria-label={`Commits per month over the last year for ${repo.name}`}
      >
        {bars.map((bar) => (
          <rect
            x={bar.x + 1}
            y={H - bar.height}
            width={Math.max(1, barWidth - 2)}
            height={bar.height}
            rx="1"
            fill="currentColor"
          />
        ))}
      </svg>
    )}
  </div>
</article>
