---
export interface Props {
  monthly: { label: string; count: number }[];
}

const { monthly } = Astro.props;
const max = Math.max(1, ...monthly.map((m) => m.count));
---

<div
  class="flex h-44 items-end gap-2 sm:gap-3"
  role="img"
  aria-label="Contributions per month over the last year"
>
  {monthly.map(({ label, count }) => (
    <div class="group flex h-full flex-1 flex-col items-center justify-end gap-2">
      <span class="text-xs font-semibold text-muted opacity-0 transition-opacity duration-200 group-hover:opacity-100">
        {count}
      </span>
      <div
        class="w-full max-w-10 rounded-t-md bg-gradient-to-t from-accent to-accent-2 transition-transform duration-300 ease-out-expo group-hover:scale-y-105 motion-reduce:transition-none motion-reduce:group-hover:scale-y-100"
        style={`height: ${Math.max(2, Math.round((count / max) * 100))}%; transform-origin: bottom;`}
        title={`${label}: ${count} contributions`}
      />
      <span class="text-[10px] font-medium text-subtle">{label}</span>
    </div>
  ))}
</div>
