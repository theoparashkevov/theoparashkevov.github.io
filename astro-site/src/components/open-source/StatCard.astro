---
import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';

export interface Props {
  icon: IconName;
  value: string | number;
  label: string;
  hint?: string;
}

const { icon, value, label, hint } = Astro.props;
---

<div class="rounded-2xl border border-border bg-surface p-5 shadow-soft">
  <div class="flex items-center gap-2 text-muted">
    <Icon name={icon} size={16} class="text-accent" />
    <dt class="text-xs font-medium uppercase tracking-wide">{label}</dt>
  </div>
  <dd class="mt-2 text-2xl font-bold tracking-tight text-fg">{value}</dd>
  {hint && <p class="mt-1 text-xs text-subtle">{hint}</p>}
</div>
