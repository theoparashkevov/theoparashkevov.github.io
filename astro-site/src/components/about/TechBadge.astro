---
import type { Tech } from './data';

export interface Props {
  tech: Tech;
}

const { tech } = Astro.props;
---

<div class="hover-lift h-full">
  <div class="group relative flex h-full items-center gap-3 rounded-xl border border-border bg-surface p-3 transition-[border-color,box-shadow,background-color] duration-300 hover:border-accent/50 hover:bg-surface-2 hover:shadow-soft focus-within:border-accent/50">
    <span class="flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-surface-2 p-2 ring-1 ring-border transition-transform duration-500 ease-spring group-hover:bg-surface motion-safe:group-hover:scale-110 motion-safe:group-hover:-rotate-6 dark:bg-fg/90 dark:ring-transparent dark:group-hover:bg-fg">
      <img
        src={tech.icon}
        alt={`${tech.name} logo`}
        width="32"
        height="32"
        loading="lazy"
        decoding="async"
        class="size-8 object-contain"
      />
    </span>
    <span class="min-w-0">
      <span class="block truncate text-sm font-semibold text-fg">{tech.name}</span>
      <span class="block text-xs leading-snug text-muted">{tech.description}</span>
    </span>
  </div>
</div>
