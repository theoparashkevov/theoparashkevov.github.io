---
import AboutIcon from './AboutIcon.astro';
import Icon from '../Icon.astro';
import type { CertificationGroup } from './data';

export interface Props {
  groups: CertificationGroup[];
}

const { groups } = Astro.props;
---

<div class="grid gap-6 lg:grid-cols-2" data-reveal-stagger="100">
  {groups.map((group, index) => (
    <article
      class:list={[
        'flex flex-col rounded-2xl border border-border bg-surface p-6 shadow-soft',
        index === 0 && 'lg:row-span-2',
      ]}
      data-reveal
    >
      <header class="flex items-center gap-3">
        {group.logo ? (
          <span class="flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-surface-2 p-2 ring-1 ring-border dark:bg-fg/90 dark:ring-transparent">
            <img
              src={group.logo.src}
              alt={group.logo.alt}
              width="32"
              height="32"
              loading="lazy"
              decoding="async"
              class="size-8 object-contain"
            />
          </span>
        ) : (
          <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent">
            <AboutIcon name={group.icon} size={22} />
          </span>
        )}
        <h3 class="text-lg font-semibold tracking-tight">{group.title}</h3>
      </header>
      <ul class="mt-5 space-y-5" role="list">
        {group.items.map((cert) => (
          <li>
            <div>
              {cert.href ? (
                <a
                  href={cert.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-underline group/cert inline-flex items-center gap-1 font-semibold text-fg transition-colors hover:text-accent"
                >
                  {cert.title}
                  <Icon
                    name="external"
                    size={14}
                    class="text-subtle transition-transform duration-300 motion-safe:group-hover/cert:translate-x-0.5 motion-safe:group-hover/cert:-translate-y-0.5"
                  />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              ) : (
                <span class="font-semibold text-fg">{cert.title}</span>
              )}
              {cert.issuer && <p class="mt-0.5 text-sm text-muted">{cert.issuer}</p>}
            </div>
            {cert.courses && (
              <ol class="mt-3 space-y-1.5 border-l border-border pl-4 text-sm" role="list">
                {cert.courses.map((course) => (
                  <li>
                    <a
                      href={course.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group/course flex items-start gap-2 text-muted transition-colors hover:text-accent"
                    >
                      <Icon name="check" size={14} class="mt-1 shrink-0 text-accent" />
                      <span>{course.title}</span>
                      <span class="sr-only">(opens in a new tab)</span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ul>
    </article>
  ))}
</div>
