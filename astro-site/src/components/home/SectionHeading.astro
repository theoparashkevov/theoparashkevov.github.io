---
import Icon from '../Icon.astro';

export interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const { id, eyebrow, title, description, href, linkLabel = 'View all' } = Astro.props;
---

<div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between" data-reveal>
  <div class="max-w-2xl">
    <p class="text-xs font-semibold tracking-[0.18em] text-accent uppercase">{eyebrow}</p>
    <h2 id={id} class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl">
      {title}
    </h2>
    {description && (
      <p class="mt-3 text-base leading-relaxed text-pretty text-muted">{description}</p>
    )}
  </div>
  {href && (
    <a
      href={href}
      class="group inline-flex shrink-0 items-center gap-1.5 self-start rounded-md text-sm font-semibold text-accent sm:self-auto"
    >
      <span class="link-underline">{linkLabel}</span>
      <Icon
        name="arrow-right"
        size={16}
        class="transition-transform duration-300 ease-out-expo group-hover:translate-x-1"
      />
    </a>
  )}
</div>
