---
import Icon from '../Icon.astro';
import SectionHeading from './SectionHeading.astro';

export interface Props {
  categories: { name: string; slug: string; count: number }[];
}

const ACRONYMS = new Set(['ai', 'ml', 'nlp', 'llm', 'sql', 'api', 'cv']);

function displayName(name: string): string {
  if (ACRONYMS.has(name.toLowerCase())) return name.toUpperCase();
  return name.charAt(0).toUpperCase() + name.slice(1);
}

const merged = new Map<string, { name: string; slug: string; count: number }>();
for (const category of Astro.props.categories) {
  const existing = merged.get(category.slug);
  if (existing) existing.count += category.count;
  else merged.set(category.slug, { ...category, name: displayName(category.name) });
}
const topics = [...merged.values()].sort(
  (a, b) => b.count - a.count || a.name.localeCompare(b.name)
);
---

{topics.length > 0 && (
  <section class="relative border-y border-border bg-surface/60" aria-labelledby="topics-title">
    <div class="container-page py-16 sm:py-20">
      <SectionHeading
        id="topics-title"
        eyebrow="Browse"
        title="Explore by topic"
        description="Jump straight to the subjects you care about."
      />
      <ul class="mt-10 flex flex-wrap gap-3" data-reveal-stagger="50">
        {topics.map((topic) => (
          <li data-reveal="scale">
            <a
              href={`/blog/category/${topic.slug}/`}
              class="hover-lift press group inline-flex items-center gap-2 rounded-full border border-border bg-surface py-2 pr-2 pl-4 text-sm font-medium text-fg shadow-soft transition-colors duration-300 hover:border-accent/50 hover:text-accent"
            >
              <Icon
                name="tag"
                size={15}
                class="text-subtle transition-colors duration-300 group-hover:text-accent"
              />
              {topic.name}
              <span class="rounded-full bg-surface-2 px-2 py-0.5 text-xs text-muted tabular-nums transition-colors duration-300 group-hover:bg-accent-soft group-hover:text-accent">
                {topic.count}
                <span class="sr-only">{topic.count === 1 ? 'post' : 'posts'}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
