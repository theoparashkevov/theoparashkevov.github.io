---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import portrait from '../../assets/portrait-square.jpg';
import { AUTHOR, SITE_TAGLINE, SOCIAL_LINKS } from '../../consts';

const socials = SOCIAL_LINKS.filter((link) => link.icon !== 'rss');
const portraitAlt = `Portrait of ${AUTHOR.name}`;
---

<section class="hero relative isolate overflow-hidden" aria-labelledby="hero-title">
  <div class="hero-backdrop" aria-hidden="true"></div>

  <div class="container-page grid items-center gap-14 pt-12 pb-20 sm:pt-16 lg:grid-cols-[1.2fr_0.8fr] lg:gap-10 lg:pt-24 lg:pb-28">
    <div class="order-2 text-center lg:order-1 lg:text-left">
      <p class="enter" style="--i: 0">
        <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/70 px-3.5 py-1.5 text-xs font-medium text-muted shadow-soft backdrop-blur">
          <span class="relative flex size-2" aria-hidden="true">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent-2 opacity-60 motion-reduce:animate-none"></span>
            <span class="relative inline-flex size-2 rounded-full bg-accent-2"></span>
          </span>
          Writing about ML, Python &amp; software craft
        </span>
      </p>

      <h1
        id="hero-title"
        class="enter mt-6 text-5xl leading-[1.05] font-bold tracking-tight text-balance sm:text-6xl lg:text-7xl"
        style="--i: 1"
      >
        Hi, I'm <span class="text-gradient">{AUTHOR.name}</span>
      </h1>

      <p class="enter mt-5 text-lg font-semibold text-fg/80 sm:text-xl" style="--i: 2">
        {SITE_TAGLINE}
      </p>

      <p
        class="enter mx-auto mt-5 max-w-xl text-base leading-relaxed text-pretty text-muted sm:text-lg lg:mx-0"
        style="--i: 3"
      >
        I design and build scalable software systems that put machine learning to work, from data
        pipelines and model training to clean, production-ready Python. This is where I share what I
        learn about AI, data and software engineering.
      </p>

      <div class="enter mt-9 flex flex-wrap justify-center gap-3 lg:justify-start" style="--i: 4">
        <a
          href="/blog/"
          class="press group inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-accent-contrast shadow-soft transition duration-300 ease-out-expo hover:-translate-y-0.5 hover:shadow-lift"
        >
          Read the blog
          <Icon
            name="arrow-right"
            size={18}
            class="transition-transform duration-300 ease-out-expo group-hover:translate-x-1"
          />
        </a>
        <a
          href="/about/"
          class="press inline-flex items-center gap-2 rounded-full border border-border bg-surface px-6 py-3 text-sm font-semibold text-fg shadow-soft transition duration-300 ease-out-expo hover:-translate-y-0.5 hover:border-accent/50 hover:text-accent hover:shadow-lift"
        >
          About me
        </a>
      </div>

      <ul
        class="enter mt-10 flex items-center justify-center gap-2.5 lg:justify-start"
        style="--i: 5"
        aria-label="Social links"
      >
        {socials.map((link) => {
          const external = link.href.startsWith('http');
          return (
            <li>
              <a
                href={link.href}
                class="press grid size-10 place-items-center rounded-full border border-border bg-surface/80 text-muted transition duration-300 ease-out-expo hover:-translate-y-0.5 hover:border-accent/50 hover:text-accent"
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                <Icon name={link.icon} size={18} label={link.label} />
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="order-1 flex justify-center lg:order-2 lg:justify-end">
      <div class="portrait relative aspect-square w-60 sm:w-72 lg:w-[22rem]">
        <div class="portrait-blob" aria-hidden="true"></div>
        <div class="portrait-ring" aria-hidden="true"></div>
        <Image
          src={portrait}
          alt={portraitAlt}
          width={704}
          height={704}
          widths={[240, 352, 480, 704]}
          sizes="(min-width: 1024px) 22rem, (min-width: 640px) 18rem, 15rem"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
          class="portrait-img relative size-full rounded-full object-cover shadow-lift ring-[6px] ring-bg"
        />
        <span
          class="chip chip-a absolute top-6 -left-6 inline-flex items-center gap-2 rounded-full border border-border bg-surface/85 px-3.5 py-2 text-xs font-semibold text-fg shadow-lift backdrop-blur sm:-left-12"
          aria-hidden="true"
        >
          <Icon name="sparkles" size={16} class="text-accent" />
          Machine Learning
        </span>
        <span
          class="chip chip-b absolute -right-4 bottom-8 inline-flex items-center gap-2 rounded-full border border-border bg-surface/85 px-3.5 py-2 text-xs font-semibold text-fg shadow-lift backdrop-blur sm:-right-10"
          aria-hidden="true"
        >
          <Icon name="code" size={16} class="text-accent-2" />
          Senior Python
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        55% 45% at 12% 8%,
        color-mix(in oklab, var(--accent) 16%, transparent),
        transparent 70%
      ),
      radial-gradient(
        45% 45% at 88% 28%,
        color-mix(in oklab, var(--accent-2) 14%, transparent),
        transparent 70%
      );
  }

  .hero-backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      color-mix(in oklab, var(--fg) 13%, transparent) 1px,
      transparent 1.5px
    );
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 35%, #000 15%, transparent 75%);
  }

  .enter {
    animation: home-rise 900ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)) both;
    animation-delay: calc(var(--i, 0) * 90ms + 80ms);
  }

  .portrait {
    animation: home-pop 1200ms var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)) 120ms both;
  }

  .portrait-blob {
    position: absolute;
    inset: -16%;
    z-index: -1;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    filter: blur(48px);
    opacity: 0.32;
    border-radius: 42% 58% 63% 37% / 41% 44% 56% 59%;
    animation:
      home-morph 14s ease-in-out infinite alternate,
      home-spin 40s linear infinite;
  }

  :global(.dark) .portrait-blob {
    opacity: 0.4;
  }

  .portrait-ring {
    position: absolute;
    inset: -12px;
    border-radius: 9999px;
    background: conic-gradient(
      from 0deg,
      var(--accent),
      var(--accent-2),
      transparent 38%,
      transparent 58%,
      var(--accent-2),
      var(--accent)
    );
    -webkit-mask: radial-gradient(
      farthest-side,
      transparent calc(100% - 3px),
      #000 calc(100% - 2px)
    );
    mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
    animation: home-spin 12s linear infinite;
  }

  .chip {
    animation:
      home-chip-in 900ms var(--ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1)) 700ms both,
      home-float 7s ease-in-out 1600ms infinite;
  }

  .chip-b {
    animation-delay: 850ms, 2400ms;
  }

  @keyframes home-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  @keyframes home-pop {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes home-chip-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.85);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes home-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @keyframes home-spin {
    to {
      rotate: 360deg;
    }
  }

  @keyframes home-morph {
    0% {
      border-radius: 42% 58% 63% 37% / 41% 44% 56% 59%;
    }
    50% {
      border-radius: 63% 37% 45% 55% / 55% 62% 38% 45%;
    }
    100% {
      border-radius: 38% 62% 56% 44% / 62% 38% 62% 38%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .enter,
    .portrait,
    .portrait-blob,
    .portrait-ring,
    .chip {
      animation: none;
    }
  }
</style>
