---
import Icon from '../Icon.astro';
import SectionHeading from './SectionHeading.astro';

const areas = [
  {
    title: 'Machine Learning',
    icon: 'sparkles',
    description:
      'Developing and deploying machine learning models for natural language processing, computer vision and predictive analytics.',
    tools: ['PyTorch', 'TensorFlow', 'scikit-learn'],
  },
  {
    title: 'Software Engineering',
    icon: 'code',
    description:
      'Designing scalable, robust and efficient software with a focus on performance, clean architecture and maintainable code.',
    tools: ['Python', 'Design patterns', 'Clean code'],
  },
  {
    title: 'Data Analysis',
    icon: 'chart',
    description:
      'Data preprocessing, exploratory analysis and statistical modeling that turn raw data into insight and data-driven decisions.',
    tools: ['Pandas', 'NumPy', 'SQL'],
  },
] as const;
---

<section class="container-page py-20 sm:py-24" aria-labelledby="focus-title">
  <SectionHeading
    id="focus-title"
    eyebrow="What I do"
    title="Where I focus"
    description="Three areas I keep coming back to, both in my day-to-day work and on this blog."
  />

  <ul class="mt-12 grid gap-6 md:grid-cols-3" data-reveal-stagger="110">
    {areas.map((area, index) => (
      <li data-reveal class="h-full">
        <article class="focus-card hover-lift group relative isolate flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface p-7 shadow-soft transition-colors duration-300 hover:border-accent/40">
          <span class="focus-glow" aria-hidden="true"></span>
          <span class="absolute top-6 right-6 font-mono text-xs text-subtle" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <span class="grid size-12 place-items-center rounded-xl bg-accent-soft text-accent transition-transform duration-500 ease-spring group-hover:scale-110 group-hover:-rotate-6">
            {area.icon === 'chart' ? (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 3v16a2 2 0 0 0 2 2h16" />
                <path d="M18 17V9" />
                <path d="M13 17V5" />
                <path d="M8 17v-3" />
              </svg>
            ) : (
              <Icon name={area.icon} size={24} />
            )}
          </span>
          <h3 class="mt-6 text-xl font-semibold tracking-tight">{area.title}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{area.description}</p>
          <ul class="mt-6 flex flex-wrap gap-2" aria-label={`${area.title} tools`}>
            {area.tools.map((tool) => (
              <li class="rounded-full border border-border bg-surface-2 px-2.5 py-1 font-mono text-[0.7rem] text-muted">
                {tool}
              </li>
            ))}
          </ul>
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
  .focus-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      120% 80% at 0% 0%,
      color-mix(in oklab, var(--accent) 10%, transparent),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 500ms var(--ease-out-expo, ease-out);
  }

  .focus-card::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), var(--accent-2), transparent);
    transform: scaleX(0);
    transition: transform 600ms var(--ease-out-expo, ease-out);
  }

  .focus-card:hover .focus-glow {
    opacity: 1;
  }

  .focus-card:hover::after {
    transform: scaleX(1);
  }
</style>
