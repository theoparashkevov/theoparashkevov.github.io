---
import Icon from './Icon.astro';
import { AUTHOR, NAV_LINKS, SITE_TAGLINE, SOCIAL_LINKS } from '../consts';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border bg-surface/60">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-sm">
      <a href="/" class="group inline-flex items-center gap-3 rounded-lg">
        <span
          class="footer-monogram inline-flex size-9 items-center justify-center rounded-xl text-sm font-bold tracking-tight text-accent-contrast"
          aria-hidden="true"
        >
          TP
        </span>
        <span class="font-semibold tracking-tight text-fg transition-colors duration-200 group-hover:text-accent">
          {AUTHOR.name}
        </span>
      </a>
      <p class="mt-4 text-sm leading-relaxed text-muted">
        {SITE_TAGLINE} writing about scalable systems, AI, and the craft of building software.
      </p>
    </div>

    <nav aria-label="Footer">
      <h2 class="text-xs font-semibold tracking-wider text-subtle uppercase">Explore</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2.5 text-sm md:grid-cols-1">
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="link-underline text-muted transition-colors duration-200 hover:text-fg"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="text-xs font-semibold tracking-wider text-subtle uppercase">Connect</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {SOCIAL_LINKS.map((social) => {
          const external = social.href.startsWith('http');
          return (
            <li>
              <a
                href={social.href}
                class="social-link inline-flex size-10 items-center justify-center rounded-full border border-border bg-surface text-muted transition-[color,border-color,box-shadow,translate] duration-300 ease-spring hover:-translate-y-0.5 hover:border-accent hover:text-accent hover:shadow-soft focus-visible:text-accent"
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                title={social.label}
              >
                <Icon name={social.icon} size={18} label={social.label} />
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container-page flex flex-col-reverse items-center justify-between gap-3 py-6 text-xs text-subtle sm:flex-row">
      <p>
        © {year} {AUTHOR.name}.{' '}
        <span>
          Built with{' '}
          <a
            href="https://astro.build"
            class="link-underline font-medium text-muted transition-colors duration-200 hover:text-accent"
            target="_blank"
            rel="noopener noreferrer"
          >
            Astro
          </a>
        </span>
      </p>
      <a
        href="#top"
        class="back-to-top group inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 font-medium text-muted transition-colors duration-200 hover:bg-surface-2 hover:text-fg"
        data-back-to-top
      >
        Back to top
        <Icon
          name="arrow-up"
          size={14}
          class="transition-transform duration-300 ease-spring group-hover:-translate-y-0.5"
        />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-monogram {
    background-image: linear-gradient(135deg, var(--accent), var(--accent-2));
  }

  .social-link :global(svg) {
    transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .social-link:hover :global(svg) {
    transform: scale(1.12);
  }
</style>

<script>
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest('[data-back-to-top]');
    if (!link) return;
    event.preventDefault();
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    document.querySelector<HTMLElement>('[data-site-header] a')?.focus({ preventScroll: true });
  });
</script>
