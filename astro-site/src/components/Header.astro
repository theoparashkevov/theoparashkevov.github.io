---
import { NAV_LINKS, SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import MobileNav from './MobileNav.astro';

const rawPath = Astro.url.pathname;
const path = rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  class="site-header sticky top-0 z-50 border-b border-transparent bg-bg/70 backdrop-blur-xl backdrop-saturate-150"
  transition:animate="none"
  data-site-header
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="wordmark group flex items-center gap-3 rounded-lg"
      aria-label={`${SITE_TITLE}, home`}
    >
      <span
        class="monogram inline-flex size-9 items-center justify-center rounded-xl text-sm font-bold tracking-tight text-accent-contrast shadow-soft"
        aria-hidden="true"
      >
        TP
      </span>
      <span class="text-[0.95rem] font-semibold tracking-tight text-fg transition-colors duration-200 group-hover:text-accent">
        {SITE_TITLE}
      </span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <nav class="hidden md:block" aria-label="Main">
        <ul class="flex items-center gap-1 text-sm font-medium">
          {NAV_LINKS.map((link) => {
            const active = isActive(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'nav-link relative inline-flex items-center rounded-full px-3.5 py-2 transition-colors duration-200',
                    active ? 'text-fg' : 'text-muted hover:bg-surface-2 hover:text-fg',
                  ]}
                >
                  {link.label}
                  {active && (
                    <span
                      class="nav-indicator pointer-events-none absolute inset-x-3.5 -bottom-px h-0.5 rounded-full"
                      aria-hidden="true"
                      transition:name="nav-indicator"
                      transition:animate="initial"
                    />
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
      <span class="mx-1 hidden h-5 w-px bg-border md:block" aria-hidden="true"></span>
      <ThemeToggle />
      <MobileNav isActive={isActive} />
    </div>
  </div>
</header>

<style>
  .site-header {
    transition:
      border-color 300ms ease,
      box-shadow 300ms ease,
      background-color 300ms ease;
  }

  .site-header[data-scrolled] {
    border-bottom-color: var(--border);
    box-shadow: var(--shadow-soft);
    background-color: color-mix(in srgb, var(--bg) 82%, transparent);
  }

  .monogram {
    background-image: linear-gradient(135deg, var(--accent), var(--accent-2));
    transition: transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .wordmark:hover .monogram,
  .wordmark:focus-visible .monogram {
    transform: rotate(-8deg) scale(1.06);
  }

  .nav-indicator {
    background-image: linear-gradient(90deg, var(--accent), var(--accent-2));
  }
</style>

<style is:global>
  ::view-transition-group(nav-indicator) {
    animation-duration: 450ms;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

<script>
  let ticking = false;

  function updateHeader() {
    ticking = false;
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  }

  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateHeader);
    },
    { passive: true }
  );

  document.addEventListener('astro:after-swap', updateHeader);
  document.addEventListener('astro:page-load', updateHeader);
</script>
