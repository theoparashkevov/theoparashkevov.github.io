---
import Icon from '../Icon.astro';
import { displayUrl, type Project } from './projects';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const { name, description, icon, tags, url } = project;
---

<article
  class:list={[
    'group relative flex h-full flex-col rounded-2xl border border-border bg-surface p-6 shadow-soft sm:p-7',
    url && 'hover-lift hover:border-accent/40 focus-within:border-accent/40',
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <span
      class:list={[
        'grid size-11 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent',
        url &&
          'transition-transform duration-300 ease-spring group-hover:scale-110 motion-reduce:transition-none motion-reduce:group-hover:scale-100',
      ]}
    >
      <Icon name={icon} size={22} />
    </span>
    {url && (
      <Icon
        name="external"
        size={20}
        class="text-subtle transition-[color,translate] duration-300 ease-out-expo group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent motion-reduce:transition-none motion-reduce:group-hover:translate-none"
      />
    )}
  </div>

  <h2 class="mt-5 text-xl font-semibold tracking-tight text-fg">
    {url ? (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-sm transition-colors group-hover:text-accent after:absolute after:inset-0 after:rounded-2xl after:content-[''] focus-visible:outline-none focus-visible:after:ring-2 focus-visible:after:ring-accent"
      >
        {name}
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    ) : (
      name
    )}
  </h2>

  <p class="mt-3 flex-1 leading-relaxed text-muted">{description}</p>

  {tags.length > 0 && (
    <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Technologies and topics for ${name}`}>
      {tags.map((tag) => (
        <li class="rounded-full border border-border bg-surface-2 px-3 py-1 text-xs font-medium text-muted">
          {tag}
        </li>
      ))}
    </ul>
  )}

  {url && (
    <p class="mt-5 flex items-center gap-1.5 border-t border-border pt-4 font-mono text-xs text-subtle">
      <Icon name="link" size={14} class="shrink-0" />
      <span class="truncate">{displayUrl(url)}</span>
    </p>
  )}
</article>
