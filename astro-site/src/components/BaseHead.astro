---
import { ClientRouter } from 'astro:transitions';
import JsonLd from './JsonLd.astro';
import {
  SITE_URL,
  SITE_TITLE,
  SITE_TAGLINE,
  SITE_DESCRIPTION,
  AUTHOR,
  SOCIAL_LINKS,
} from '../consts';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
}

const DEFAULT_IMAGE = '/og-default.jpg';
const DEFAULT_IMAGE_ALT = `${SITE_TITLE} — ${SITE_TAGLINE}`;

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(SITE_URL);
const siteRoot = new URL('/', site).href;

function canonicalPath(pathname: string): string {
  const path = pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
  return path.endsWith('/') ? path : `${path}/`;
}

const fullTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · ${SITE_TAGLINE}`;
const canonicalURL = new URL(canonicalPath(Astro.url.pathname), site).href;
const isDefaultImage = !image;
const imageURL = new URL(image ?? DEFAULT_IMAGE, site).href;
const resolvedImageAlt = imageAlt ?? (isDefaultImage ? DEFAULT_IMAGE_ALT : (title ?? SITE_TITLE));
const rssURL = new URL('/rss.xml', site).href;

const personId = `${siteRoot}#person`;
const websiteId = `${siteRoot}#website`;

const person = {
  '@type': 'Person',
  '@id': personId,
  name: AUTHOR.name,
  url: siteRoot,
  image: new URL(AUTHOR.avatar, site).href,
  email: `mailto:${AUTHOR.email}`,
  jobTitle: SITE_TAGLINE,
  sameAs: SOCIAL_LINKS.map((link) => link.href).filter((href) => href.startsWith('http')),
};

const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: siteRoot,
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  inLanguage: 'en',
  author: { '@id': personId },
  publisher: { '@id': personId },
};

const page =
  type === 'article'
    ? {
        '@type': 'BlogPosting',
        '@id': `${canonicalURL}#article`,
        url: canonicalURL,
        mainEntityOfPage: canonicalURL,
        headline: title ?? SITE_TITLE,
        description,
        image: imageURL,
        inLanguage: 'en',
        ...(publishedTime && { datePublished: publishedTime.toISOString() }),
        ...((modifiedTime ?? publishedTime) && {
          dateModified: (modifiedTime ?? publishedTime)!.toISOString(),
        }),
        ...(tags.length > 0 && { keywords: tags.join(', ') }),
        author: { '@id': personId },
        publisher: { '@id': personId },
        isPartOf: { '@id': websiteId },
      }
    : {
        '@type': 'WebPage',
        '@id': `${canonicalURL}#webpage`,
        url: canonicalURL,
        name: fullTitle,
        description,
        inLanguage: 'en',
        isPartOf: { '@id': websiteId },
        about: { '@id': personId },
      };

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': noindex ? [person, website] : [person, website, page],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta http-equiv="Content-Security-Policy" content="base-uri 'self'; object-src 'none'" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#f8f9fc" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0b0d14" media="(prefers-color-scheme: dark)" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={AUTHOR.name} />
<meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />
{!noindex && <link rel="canonical" href={canonicalURL} />}

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} — Blog`} href={rssURL} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
{!noindex && <meta property="og:url" content={canonicalURL} />}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={resolvedImageAlt} />
{isDefaultImage && (
  <>
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
{type === 'article' && (
  <>
    <meta property="article:author" content={new URL('/about/', site).href} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </>
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={resolvedImageAlt} />

<JsonLd data={structuredData} />

<ClientRouter />
