---
import { toString as qrToString } from 'qrcode';
import Icon from '../Icon.astro';
import { AUTHOR, SOCIAL_LINKS, SITE_URL } from '../../consts';

const github = SOCIAL_LINKS.find((link) => link.label === 'GitHub');
const linkedin = SOCIAL_LINKS.find((link) => link.label === 'LinkedIn');
const [firstName, lastName] = AUTHOR.name.split(' ').map((part) => part.trim());

// vCard 3.0 — the format phone cameras understand as "add contact".
const vcard = [
  'BEGIN:VCARD',
  'VERSION:3.0',
  `N:${lastName};${firstName};;;`,
  `FN:${AUTHOR.name}`,
  `EMAIL;TYPE=INTERNET,PREF:${AUTHOR.email}`,
  `URL:${SITE_URL}`,
  ...(github ? [`X-SOCIALPROFILE;TYPE=github:${github.href}`] : []),
  ...(linkedin ? [`X-SOCIALPROFILE;TYPE=linkedin:${linkedin.href}`] : []),
  'END:VCARD',
].join('\r\n');

const qrSvg = await qrToString(vcard, {
  type: 'svg',
  errorCorrectionLevel: 'M',
  margin: 1,
  color: { dark: '#000000', light: '#ffffff' },
});
---

<div
  class="relative overflow-hidden rounded-3xl border border-border bg-surface shadow-soft"
  data-reveal="scale"
>
  <div
    class="pointer-events-none absolute inset-x-0 -top-24 mx-auto h-48 w-2/3 rounded-full bg-accent/15 blur-3xl"
    aria-hidden="true"
  ></div>
  <div class="relative flex flex-col items-center gap-6 p-8 sm:flex-row sm:gap-10 sm:p-10">
    <div class="qr-box shrink-0 rounded-2xl border border-border bg-white p-3 shadow-soft">
      <Fragment set:html={qrSvg} />
    </div>
    <div class="text-center sm:text-left">
      <p class="inline-flex items-center gap-2 rounded-full border border-border bg-surface-2 px-3 py-1 text-xs font-medium text-muted">
        <Icon name="maximize" size={14} class="text-accent" />
        Scan to save
      </p>
      <h2 class="mt-4 text-2xl font-semibold tracking-tight text-fg">Add me to your contacts</h2>
      <p class="mt-2 leading-relaxed text-muted">
        Point your phone camera at the code to save my contact details — no typing needed.
      </p>
      <a
        href={`data:text/vcard;charset=utf-8,${encodeURIComponent(vcard)}`}
        download="teo-parashkevov.vcf"
        class="press group mt-5 inline-flex items-center gap-2 rounded-xl border border-border bg-surface-2 px-5 py-3 text-sm font-semibold text-fg transition-colors duration-300 hover:border-accent/40 hover:text-accent"
      >
        <Icon name="download" size={16} />
        Download vCard
      </a>
    </div>
  </div>
</div>

<style>
  .qr-box :global(svg) {
    display: block;
    width: 176px;
    height: 176px;
  }
</style>
