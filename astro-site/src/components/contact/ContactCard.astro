---
import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';

export interface Props {
  icon: IconName;
  title: string;
  href: string;
  cta?: string;
  delay?: number;
}

const { icon, title, href, cta = 'Send me an email', delay } = Astro.props;
const headingId = `contact-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<article
  class="group hover-lift relative flex h-full flex-col rounded-2xl border border-border bg-surface p-6 shadow-soft transition-[border-color,box-shadow,transform] duration-300 ease-out-expo hover:border-accent/40 hover:shadow-lift sm:p-7"
  aria-labelledby={headingId}
  data-reveal
  style={delay !== undefined ? `--reveal-delay: ${delay}ms` : undefined}
>
  <div class="mb-5 inline-flex size-12 items-center justify-center rounded-xl bg-accent-soft text-accent ring-1 ring-accent/15 transition-transform duration-500 ease-spring group-hover:-rotate-6 group-hover:scale-110 motion-reduce:transition-none motion-reduce:group-hover:transform-none">
    <Icon name={icon} size={24} />
  </div>
  <h2 id={headingId} class="text-xl font-semibold tracking-tight text-fg">
    {title}
  </h2>
  <p class="mt-3 flex-1 leading-relaxed text-muted">
    <slot />
  </p>
  <a
    href={href}
    class="press mt-6 inline-flex items-center gap-2 self-start rounded-full bg-accent px-4 py-2 text-sm font-medium text-accent-contrast shadow-soft transition-[filter,box-shadow] duration-200 hover:shadow-lift hover:brightness-110 focus-visible:ring-4 focus-visible:ring-ring"
    aria-label={`${cta}: ${title}`}
  >
    <Icon name="mail" size={16} />
    {cta}
    <Icon
      name="arrow-right"
      size={16}
      class="transition-transform duration-300 ease-out-expo group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
    />
  </a>
</article>
