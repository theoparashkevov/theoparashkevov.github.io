---
import Icon from '../Icon.astro';
import { AUTHOR } from '../../consts';

export interface Props {
  email?: string;
  class?: string;
}

const { email = AUTHOR.email, class: className } = Astro.props;
---

<div
  class:list={[
    'inline-flex max-w-full items-center gap-1 rounded-full border border-border bg-surface p-1.5 pl-4 shadow-soft',
    className,
  ]}
  data-copy-email-root
>
  <a
    href={`mailto:${email}`}
    class="link-underline truncate font-mono text-sm text-fg hover:text-accent sm:text-base"
  >
    {email}
  </a>
  <button
    type="button"
    class="press relative ml-2 inline-flex shrink-0 items-center gap-1.5 rounded-full bg-surface-2 px-3 py-1.5 text-sm font-medium text-muted transition-colors duration-200 hover:bg-accent-soft hover:text-accent focus-visible:ring-4 focus-visible:ring-ring data-[copied]:bg-accent-soft data-[copied]:text-accent"
    data-copy-email={email}
    aria-label={`Copy email address ${email}`}
  >
    <span class="copy-icon relative inline-flex size-4" aria-hidden="true">
      <Icon name="copy" size={16} class="icon-copy absolute inset-0" />
      <Icon name="check" size={16} class="icon-check absolute inset-0" />
    </span>
    <span data-copy-label>Copy</span>
  </button>
  <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
</div>

<style>
  .copy-icon :global(.icon-copy),
  .copy-icon :global(.icon-check) {
    transition:
      opacity 200ms ease,
      transform 300ms var(--ease-spring);
  }

  .copy-icon :global(.icon-check) {
    opacity: 0;
    transform: scale(0.4) rotate(-45deg);
  }

  [data-copied] .copy-icon :global(.icon-copy) {
    opacity: 0;
    transform: scale(0.4) rotate(45deg);
  }

  [data-copied] .copy-icon :global(.icon-check) {
    opacity: 1;
    transform: none;
  }

  .copy-failed button {
    animation: copy-shake 400ms ease;
  }

  @keyframes copy-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-3px);
    }
    75% {
      transform: translateX(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-icon :global(.icon-copy),
    .copy-icon :global(.icon-check) {
      transition: none;
    }

    .copy-failed button {
      animation: none;
    }
  }
</style>

<script>
  const RESET_MS = 2000;
  const timers = new Map<HTMLButtonElement, number>();

  async function copyText(text: string): Promise<boolean> {
    if (!navigator.clipboard) return false;
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  function setState(button: HTMLButtonElement, state: 'idle' | 'copied' | 'failed') {
    const root = button.closest<HTMLElement>('[data-copy-email-root]');
    const label = button.querySelector<HTMLElement>('[data-copy-label]');
    const status = root?.querySelector<HTMLElement>('[data-copy-status]');
    const email = button.dataset.copyEmail ?? '';

    button.toggleAttribute('data-copied', state === 'copied');
    root?.classList.toggle('copy-failed', state === 'failed');
    if (label)
      label.textContent =
        state === 'copied' ? 'Copied!' : state === 'failed' ? 'Copy manually' : 'Copy';
    if (status) {
      status.textContent =
        state === 'copied'
          ? 'Email address copied to clipboard'
          : state === 'failed'
            ? 'Copy failed. Select the email address to copy it manually.'
            : '';
    }
    button.setAttribute(
      'aria-label',
      state === 'copied' ? `Copied ${email}` : `Copy email address ${email}`
    );

    if (state === 'failed' && root) {
      const link = root.querySelector('a');
      if (link) {
        const range = document.createRange();
        range.selectNodeContents(link);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
    }
  }

  async function onClick(event: Event) {
    const button = event.currentTarget as HTMLButtonElement;
    const ok = await copyText(button.dataset.copyEmail ?? '');
    setState(button, ok ? 'copied' : 'failed');
    window.clearTimeout(timers.get(button));
    timers.set(
      button,
      window.setTimeout(() => {
        setState(button, 'idle');
        timers.delete(button);
      }, RESET_MS)
    );
  }

  function init() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
      if (button.dataset.copyBound) return;
      button.dataset.copyBound = 'true';
      button.addEventListener('click', onClick);
    });
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    timers.forEach((id) => window.clearTimeout(id));
    timers.clear();
  });
</script>
