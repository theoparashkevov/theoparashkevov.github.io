---
import Icon from './Icon.astro';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  class:list={[
    'theme-toggle press relative inline-flex size-10 items-center justify-center rounded-full text-muted transition-colors duration-200 hover:bg-surface-2 hover:text-fg',
    className,
  ]}
  aria-label="Dark mode"
  aria-pressed="false"
  title="Toggle dark mode"
  data-theme-toggle
>
  <Icon name="sun" size={20} class="theme-icon theme-icon-sun" />
  <Icon name="moon" size={20} class="theme-icon theme-icon-moon" />
</button>

<style>
  .theme-toggle :global(.theme-icon) {
    position: absolute;
    transition:
      transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 250ms ease;
  }

  .theme-toggle :global(.theme-icon-moon) {
    opacity: 0;
    transform: rotate(-90deg) scale(0.4);
  }

  :global(.dark) .theme-toggle :global(.theme-icon-sun) {
    opacity: 0;
    transform: rotate(90deg) scale(0.4);
  }

  :global(.dark) .theme-toggle :global(.theme-icon-moon) {
    opacity: 1;
    transform: none;
  }

  .theme-toggle:hover :global(.theme-icon-sun) {
    transform: rotate(45deg);
  }

  :global(.dark) .theme-toggle:hover :global(.theme-icon-moon) {
    transform: rotate(-15deg) scale(1.05);
  }
</style>

<script>
  const STORAGE_KEY = 'theme';
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  function storedTheme(): 'light' | 'dark' | null {
    try {
      const value = localStorage.getItem(STORAGE_KEY);
      return value === 'light' || value === 'dark' ? value : null;
    } catch {
      return null;
    }
  }

  function syncToggles() {
    const dark = document.documentElement.classList.contains('dark');
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
      button.setAttribute('aria-pressed', String(dark));
      button.title = dark ? 'Switch to light mode' : 'Switch to dark mode';
    });
  }

  function applyTheme(dark: boolean) {
    document.documentElement.classList.toggle('dark', dark);
    syncToggles();
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (!target?.closest('[data-theme-toggle]')) return;
    const dark = !document.documentElement.classList.contains('dark');
    try {
      localStorage.setItem(STORAGE_KEY, dark ? 'dark' : 'light');
    } catch {
      /* storage unavailable: theme still applies for this page view */
    }
    applyTheme(dark);
  });

  media.addEventListener('change', (event) => {
    if (!storedTheme()) applyTheme(event.matches);
  });

  window.addEventListener('storage', (event) => {
    if (event.key !== STORAGE_KEY) return;
    const value = storedTheme();
    applyTheme(value ? value === 'dark' : media.matches);
  });

  document.addEventListener('astro:page-load', syncToggles);
</script>
