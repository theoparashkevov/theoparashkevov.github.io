---
/*
 * Prepares shared-element morphs right before each view-transition snapshot:
 * tags elements named by transitionName() with a view-transition-class
 * (post-title, post-hero, ...) so animations.css can tune them, and drops
 * duplicate names, which would otherwise abort the whole transition.
 */
---

<script>
  import { morphClass } from '../../lib/transitions';

  const DEDUPED = 'vtDeduped';

  function isRendered(el: HTMLElement) {
    return el.getClientRects().length > 0;
  }

  function inViewport(el: HTMLElement) {
    const rect = el.getBoundingClientRect();
    return rect.bottom > 0 && rect.top < window.innerHeight;
  }

  function prepareMorphs() {
    const byName = new Map<string, HTMLElement[]>();

    for (const el of document.querySelectorAll<HTMLElement>('[data-astro-transition-scope]')) {
      if (el.dataset[DEDUPED] !== undefined) {
        el.style.removeProperty('view-transition-name');
        delete el.dataset[DEDUPED];
      }
      const name = getComputedStyle(el).getPropertyValue('view-transition-name').trim();
      if (!name || name === 'none') continue;

      const kind = morphClass(name);
      if (kind) el.style.setProperty('view-transition-class', kind);

      if (!isRendered(el)) continue;
      const group = byName.get(name);
      if (group) group.push(el);
      else byName.set(name, [el]);
    }

    for (const group of byName.values()) {
      if (group.length < 2) continue;
      const keep = group.find(inViewport) ?? group[0];
      for (const el of group) {
        if (el === keep) continue;
        el.style.setProperty('view-transition-name', 'none');
        el.dataset[DEDUPED] = '';
      }
    }
  }

  document.addEventListener('astro:after-preparation', prepareMorphs);
  document.addEventListener('astro:after-swap', prepareMorphs);
</script>
