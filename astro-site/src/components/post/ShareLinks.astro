---
import Icon from '../Icon.astro';

export interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const xHref = `https://x.com/intent/post?${new URLSearchParams({ text: title, url })}`;
const linkedInHref = `https://www.linkedin.com/sharing/share-offsite/?${new URLSearchParams({ url })}`;
const buttonClass =
  'inline-flex h-10 items-center gap-2 rounded-full border border-border bg-surface px-4 text-sm font-medium text-muted transition-[color,background-color,border-color,scale] duration-200 hover:border-accent/40 hover:bg-accent-soft hover:text-accent active:scale-95';
---

<div class="flex flex-wrap items-center gap-3">
  <span class="mr-1 text-sm font-semibold text-fg">Share</span>
  <a href={xHref} target="_blank" rel="noopener noreferrer" class={buttonClass}>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="15"
      height="15"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
    </svg>
    <span>X</span>
    <span class="sr-only">(opens in a new tab)</span>
  </a>
  <a href={linkedInHref} target="_blank" rel="noopener noreferrer" class={buttonClass}>
    <Icon name="linkedin" size={15} />
    <span>LinkedIn</span>
    <span class="sr-only">(opens in a new tab)</span>
  </a>
  <button
    type="button"
    class:list={[buttonClass, 'share-copy cursor-pointer']}
    data-copy-link={url}
  >
    <span class="share-copy-icons relative inline-grid size-[15px]" aria-hidden="true">
      <Icon name="link" size={15} class="share-copy-idle" />
      <Icon name="check" size={15} class="share-copy-done" />
    </span>
    <span class="share-copy-label">Copy link</span>
  </button>
  <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
</div>

<style>
  .share-copy-icons > :global(svg) {
    grid-area: 1 / 1;
    transition:
      opacity 200ms var(--ease-out-expo),
      transform 300ms var(--ease-spring);
  }

  .share-copy-icons > :global(.share-copy-done) {
    opacity: 0;
    transform: scale(0.4) rotate(-20deg);
  }

  .share-copy.is-copied {
    border-color: color-mix(in oklab, var(--accent) 50%, transparent);
    background-color: var(--accent-soft);
    color: var(--accent);
  }

  .share-copy.is-copied :global(.share-copy-idle) {
    opacity: 0;
    transform: scale(0.4);
  }

  .share-copy.is-copied :global(.share-copy-done) {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  const timers = new WeakMap<HTMLElement, number>();

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  async function handleCopy(button: HTMLButtonElement) {
    const ok = await copyText(button.dataset.copyLink ?? window.location.href);
    const label = button.querySelector('.share-copy-label');
    const status = button.parentElement?.querySelector('[data-copy-status]');
    if (label) label.textContent = ok ? 'Copied!' : 'Copy failed';
    if (status) status.textContent = ok ? 'Link copied to clipboard' : 'Could not copy the link';
    button.classList.toggle('is-copied', ok);
    window.clearTimeout(timers.get(button));
    timers.set(
      button,
      window.setTimeout(() => {
        button.classList.remove('is-copied');
        if (label) label.textContent = 'Copy link';
        if (status) status.textContent = '';
      }, 2000)
    );
  }

  document.addEventListener('astro:page-load', () => {
    document
      .querySelectorAll<HTMLButtonElement>('[data-copy-link]:not([data-copy-bound])')
      .forEach((button) => {
        button.dataset.copyBound = '';
        button.addEventListener('click', () => handleCopy(button));
      });
  });
</script>
