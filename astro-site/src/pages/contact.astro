---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ContactCard from '../components/contact/ContactCard.astro';
import CopyEmail from '../components/contact/CopyEmail.astro';
import SocialLinks from '../components/contact/SocialLinks.astro';
import type { IconName } from '../components/Icon.astro';
import { AUTHOR } from '../consts';

const BODY = 'Hello Teo,\r\n\r\nI am reaching out to you, because ...';

const mailto = (subject: string, body = BODY) =>
  `mailto:${AUTHOR.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const purposes: { icon: IconName; title: string; subject: string; text: string }[] = [
  {
    icon: 'briefcase',
    title: 'Job Opportunities',
    subject: 'Job Opportunity',
    text: 'If you are a recruiter or a hiring manager interested in my profile, I welcome you to reach out to me regarding any job opportunities.',
  },
  {
    icon: 'users',
    title: 'Development Collaboration',
    subject: 'Development Collaboration',
    text: "If you are a passionate developer looking to create innovative projects together, please don't hesitate to get in touch for potential collaboration.",
  },
  {
    icon: 'graduation-cap',
    title: 'Teaching',
    subject: 'Mentoring',
    text: "If you're seeking to enhance your programming skills or embark on a journey in software development, feel free to contact me for mentoring opportunities.",
  },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Teo Parashkevov about job opportunities, development collaboration, or mentoring."
>
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 -top-40 -z-10 mx-auto h-80 max-w-3xl rounded-full bg-accent/10 blur-3xl dark:bg-accent/15"
      aria-hidden="true"
    ></div>
    <div class="container-page pt-16 pb-12 text-center sm:pt-24">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium tracking-wide text-muted uppercase shadow-soft"
        data-reveal="fade"
      >
        <Icon name="mail" size={14} class="text-accent" />
        Contact
      </p>
      <h1
        class="mt-6 text-4xl font-bold tracking-tight text-balance text-fg sm:text-5xl"
        data-reveal
        style="--reveal-delay: 80ms"
      >
        Let's <span class="text-gradient">work together</span>
      </h1>
      <p
        class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-muted"
        data-reveal
        style="--reveal-delay: 160ms"
      >
        Whether it's a role, a project, or mentoring, the best way to reach me is by email. Pick the
        topic that fits and a message will be ready to go.
      </p>
      <div class="mt-8 flex justify-center" data-reveal="scale" style="--reveal-delay: 240ms">
        <CopyEmail />
      </div>
    </div>
  </section>

  <section class="container-page" aria-label="Ways to work with me">
    <div class="grid gap-6 md:grid-cols-3">
      {purposes.map((purpose, index) => (
        <ContactCard
          icon={purpose.icon}
          title={purpose.title}
          href={mailto(purpose.subject)}
          delay={index * 100}
        >
          {purpose.text}
        </ContactCard>
      ))}
    </div>
  </section>

  <section class="container-page mt-20" aria-labelledby="elsewhere-heading">
    <div class="mb-6 flex items-end justify-between gap-4" data-reveal>
      <div>
        <h2 id="elsewhere-heading" class="text-2xl font-semibold tracking-tight text-fg">
          Find me elsewhere
        </h2>
        <p class="mt-1 text-muted">Follow along, browse my code, or subscribe to new posts.</p>
      </div>
    </div>
    <SocialLinks />
  </section>
</BaseLayout>
