---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogHeader from '../../../components/blog/BlogHeader.astro';
import PostArchive from '../../../components/blog/PostArchive.astro';
import EmptyState from '../../../components/blog/EmptyState.astro';
import { getTagList, postsWithTag } from '../../../components/blog/tags';
import { getPublishedPosts } from '../../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  const tags = getTagList(posts);
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: {
      tag,
      posts: postsWithTag(posts, tag.slug),
    },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`#${tag.name} posts`}
  description={`All ${tag.count} ${tag.count === 1 ? 'article' : 'articles'} by Teo Parashkevov tagged #${tag.name}.`}
>
  <div class="container-page py-14 sm:py-20">
    <BlogHeader
      eyebrow="Tag"
      title={`#${tag.name}`}
      count={posts.length}
      backHref="/blog/"
      backLabel="All posts"
    >
      {`Everything I have written tagged #${tag.name}, newest first.`}
    </BlogHeader>

    <div class="mt-14">
      {posts.length > 0 ? (
        <PostArchive posts={posts} />
      ) : (
        <EmptyState
          title={`No posts tagged #${tag.name} yet`}
          message="There is nothing with this tag right now. Browse the full archive instead."
          href="/blog/"
          linkLabel="See all posts"
        />
      )}
    </div>
  </div>
</BaseLayout>
