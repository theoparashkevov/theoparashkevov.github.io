---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { PUBLICATIONS } from '../components/publications/publications';
---

<BaseLayout
  title="Publications"
  description="Academic publications and papers by Teo Parashkevov, including co-authored peer-reviewed work."
>
  <section class="container-page pt-16 pb-10 sm:pt-24">
    <p
      class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-muted"
      data-reveal="fade"
    >
      <Icon name="book" size={14} class="text-accent" />
      Peer-reviewed work
    </p>
    <h1
      class="mt-5 text-4xl font-bold tracking-tight text-fg sm:text-5xl"
      data-reveal
      style="--reveal-delay: 60ms"
    >
      <span class="text-gradient">Publications</span>
    </h1>
    <p
      class="mt-4 max-w-2xl text-lg leading-relaxed text-muted"
      data-reveal
      style="--reveal-delay: 120ms"
    >
      Papers I have written, published or co-authored. Full text is embedded where available;
      external links point to the official record on the publisher's or ResearchGate's website.
    </p>
  </section>

  <section class="container-page space-y-10 pb-24" aria-label="Publication list">
    {PUBLICATIONS.map((publication) => (
      <article
        class="overflow-hidden rounded-3xl border border-border bg-surface shadow-soft"
        data-reveal
      >
        <div class="p-6 sm:p-8">
          <p class="flex flex-wrap items-center gap-2 text-xs font-semibold tracking-wide uppercase">
            <span class="text-accent">{publication.venue}</span>
            <span class="text-subtle" aria-hidden="true">
              ·
            </span>
            <span class="text-subtle">{publication.year}</span>
            {publication.featured && (
              <>
                <span class="text-subtle" aria-hidden="true">
                  ·
                </span>
                <span class="inline-flex items-center gap-1 rounded-full bg-accent-soft px-2 py-0.5 text-accent">
                  <Icon name="sparkles" size={12} />
                  Featured
                </span>
              </>
            )}
          </p>
          <h2 class="mt-3 text-xl font-semibold tracking-tight text-balance sm:text-2xl">
            {publication.title}
          </h2>
          <p class="mt-2 text-sm text-muted">{publication.authors}</p>
          <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted sm:text-base">
            {publication.abstract}
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            {publication.links.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="press group inline-flex items-center gap-2 rounded-xl border border-border bg-bg px-4 py-2.5 text-sm font-semibold transition-colors duration-300 hover:border-accent hover:text-accent"
              >
                <Icon name="external" size={16} />
                {link.label}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            ))}
            {publication.pdf && (
              <a
                href={publication.pdf}
                download
                class="press inline-flex items-center gap-2 rounded-xl bg-accent px-4 py-2.5 text-sm font-semibold text-accent-contrast shadow-soft transition-shadow duration-300 hover:shadow-lift"
              >
                <Icon name="download" size={16} />
                Download PDF
              </a>
            )}
          </div>
        </div>

        {publication.pdf && (
          <div class="border-t border-border">
            <iframe
              src={publication.pdf}
              title={`PDF viewer: ${publication.title}`}
              class="h-[42rem] w-full bg-white"
              loading="lazy"
            >
                <p class="p-6 text-sm text-muted">
                  Your browser does not support embedded PDFs.{' '}
                  <a href={publication.pdf} class="link-underline font-medium text-accent">
                    Download the paper
                  </a>{' '}
                  instead.
                </p>
              </iframe>
          </div>
        )}
      </article>
    ))}
  </section>
</BaseLayout>
