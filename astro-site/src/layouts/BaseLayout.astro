---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NavProgress from '../components/fx/NavProgress.astro';
import MorphFx from '../components/fx/MorphFx.astro';
import Spotlight from '../components/fx/Spotlight.astro';
import { rise } from '../lib/transitions';
import type { Props as HeadProps } from '../components/BaseHead.astro';

export type Props = HeadProps & { mainClass?: string };

const { mainClass = '', ...head } = Astro.props;
---

<!doctype html>
<html lang="en" transition:name="root" transition:animate={rise()}>
  <head>
    <script is:inline>
      (function () {
        function storedTheme() {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        }
        function applyTheme(doc) {
          const stored = storedTheme();
          const dark =
            stored === 'dark' ||
            (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          doc.documentElement.classList.toggle('dark', dark);
          doc.documentElement.classList.add('js');
        }
        applyTheme(document);
        if (window.__themeSwapListener) return;
        window.__themeSwapListener = true;
        document.addEventListener('astro:before-swap', function (event) {
          applyTheme(event.newDocument);
        });
      })();
    </script>
    <BaseHead {...head} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <NavProgress />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-contrast"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class:list={['flex-1', mainClass]}>
      <slot />
    </main>
    <Footer />
    <MorphFx />
    <Spotlight />
    <script>
      import { setupReveal } from '../scripts/reveal';
      setupReveal();
    </script>
  </body>
</html>
