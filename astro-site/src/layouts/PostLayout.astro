---
import BaseLayout from './BaseLayout.astro';
import type { Post } from '../lib/posts';
import type { MarkdownHeading } from 'astro';
import { formatDate, transitionName } from '../lib/posts';

export interface Props {
  post: Post;
  headings: MarkdownHeading[];
  minutes: number;
  prev?: Post;
  next?: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroAlt, tags, categories } = post.data;
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  tags={[...categories, ...tags]}
>
  <article class="container-prose py-12">
    <h1 class="text-4xl font-bold tracking-tight" transition:name={transitionName('title', post.id)}>{title}</h1>
    <time class="mt-3 block text-sm text-muted" datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    {
      heroImage && (
        <img
          src={heroImage}
          alt={heroAlt ?? ''}
          class="mt-8 aspect-[16/9] w-full rounded-2xl object-cover"
          transition:name={transitionName('hero', post.id)}
        />
      )
    }
    <div class="prose-article mt-10">
      <slot />
    </div>
  </article>
</BaseLayout>
